*.py[cod]
*$py.class

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Runtime logs & crash reports
wxauto_logs/
wechatauto_logs/
@AutomationLog.txt
*.log
gui_crash.log
COMMIT_MSG.txt

# Virtual environments
.venv/
venv/
env/

# Config & secrets (use config.example.json as template)
config.json

