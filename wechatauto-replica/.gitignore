# AI Models (仅推送文件夹名称及内部路径，通过 .gitkeep 保持目录结构)
models/**
!models/
!models/**/
!models/**/.gitkeep
*.bin
*.incomplete
.cache/

# Portable Runtime (基础便携环境已在仓库托管，忽略本地新增的运行时缓存与大型三方库)
runtime/
*.whl
*.pt
*.safetensors
*.pth
*.onnx

